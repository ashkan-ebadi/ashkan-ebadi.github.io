<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <!-- Professional Academic Navy Background -->
  <rect width="64" height="64" rx="12" fill="#1b365d" />
  
  <!-- Subtle Academic Accent Underline -->
  <line x1="14" y1="48" x2="50" y2="48" stroke="#4a90e2" stroke-width="3" stroke-linecap="round" />
  
  <!-- Monogram Text ("AE") -->
  <text x="32" y="38" font-family="-apple-system, BlinkMacSystemFont, &#39;Segoe UI&#39;, Roboto, Helvetica, Arial, sans-serif" font-size="26" font-weight="bold" fill="#ffffff" text-anchor="middle">AE</text>
</svg>
